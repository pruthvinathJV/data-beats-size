# Copy to .env and fill in. Never commit .env.

# Hugging Face: read access (models and datasets)
HF_TOKEN=
# On a cloud GPU box, keep model caches on the persistent disk, e.g.:
# HF_HOME=/workspace/hf_cache

# Weights & Biases (optional; runs go offline if unset)
WANDB_API_KEY=
WANDB_PROJECT=vlm-data-curation

# AWS S3 (optional; uploads are skipped if S3_BUCKET is unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
