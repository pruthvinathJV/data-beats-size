# Copy to .env and fill in. Never commit .env.

# Hugging Face: read + write to your own repos
HF_TOKEN=
# Pod only: keep model/data caches on the persistent volume. Leave unset on a laptop.
# HF_HOME=/workspace/hf_cache

# Weights & Biases (runs go offline if unset)
WANDB_API_KEY=
WANDB_PROJECT=data-beats-size

# RunPod (only needed for scripted pod control)
RUNPOD_API_KEY=

# AWS S3: IAM user scoped to this one bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
